DATABASE_URL=sqlite:///./app.db

# Google 서비스 계정 JSON 키 파일 경로
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# 발송용 Gmail 계정 (실제 비밀번호가 아니라 앱 비밀번호를 사용할 것)
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# 시트에 적힌 시각을 해석할 기준 타임존 (서버 OS 시간대와 무관하게 적용됨)
TIMEZONE=Asia/Seoul

# 각 시트 행 시각보다 몇 분 앞서 시트를 읽고 이메일을 발송할지
NOTICE_LEAD_MINUTES=10

# 예약 중 시트를 읽지 못했을 때 재시도까지 대기할 시간(분)
SCHEDULE_RETRY_MINUTES=5

# 예약이 사라진 시트가 없는지 점검하는 주기(분)
WATCHDOG_INTERVAL_MINUTES=15
